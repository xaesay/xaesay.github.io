---
import { GITHUB_URL, ICP, SITE_AUTHOR, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="footer-inner">
		<p>
			&copy; {year}
			{SITE_AUTHOR} · {SITE_TITLE}
		</p>
		<p class="links">
			<a href="/rss.xml">RSS</a>
			{
				GITHUB_URL && (
					<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
						GitHub
					</a>
				)
			}
			<span>由 <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a> 驱动</span>
		</p>
		{ICP && <p class="icp">{ICP}</p>}
	</div>
</footer>
<style>
	footer {
		margin-top: 4em;
		padding: 2em 1em;
		border-top: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray));
		font-size: 0.85em;
		text-align: center;
	}
	.footer-inner {
		max-width: 720px;
		margin: auto;
	}
	footer p {
		margin: 0.25em 0;
	}
	.links {
		display: flex;
		gap: 1em;
		justify-content: center;
		flex-wrap: wrap;
	}
	.icp {
		opacity: 0.7;
	}
</style>
