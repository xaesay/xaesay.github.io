---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import type { Post } from '../utils/posts';
import { readingTime } from '../utils/posts';

interface Props {
	post: Post;
	/** 是否突出显示（列表第一篇） */
	featured?: boolean;
}

const { post, featured = false } = Astro.props;
const minutes = readingTime(post.body ?? '');
---

<article class:list={['post-card', { featured }]}>
	<a href={`/blog/${post.id}/`} class="card-link">
		{
			post.data.heroImage && (
				<Image
					width={720}
					height={360}
					src={post.data.heroImage}
					alt=""
					loading="lazy"
				/>
			)
		}
		<h3 class="title">{post.data.title}</h3>
		<p class="description">{post.data.description}</p>
		<div class="meta">
			<time datetime={post.data.pubDate.toISOString()}>
				<FormattedDate date={post.data.pubDate} />
			</time>
			<span class="dot">·</span>
			<span>约 {minutes} 分钟</span>
			{
				post.data.tags.length > 0 && (
					<span class="dot">·</span>
					<span class="tags">{post.data.tags.join(' / ')}</span>
				)
			}
		</div>
	</a>
</article>

<style>
	.post-card a {
		display: block;
		text-decoration: none;
		transition: 0.2s ease;
	}
	.post-card img {
		margin-bottom: 0.75rem;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.title {
		margin: 0 0 0.25em 0;
		color: rgb(var(--black));
		line-height: 1.3;
	}
	.featured .title {
		font-size: 1.75em;
	}
	.description {
		margin: 0 0 0.5em 0;
		color: rgb(var(--gray));
		font-size: 0.9em;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.meta {
		display: flex;
		gap: 0.5em;
		flex-wrap: wrap;
		color: rgb(var(--gray));
		font-size: 0.8em;
	}
	.post-card a:hover .title {
		color: var(--accent);
	}
	.post-card a:hover img {
		box-shadow: var(--box-shadow);
		transform: translateY(-2px);
	}
	.post-card img {
		transition: 0.2s ease;
	}
</style>
