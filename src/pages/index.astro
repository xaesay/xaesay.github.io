---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_INTRO, SITE_SHORT, SITE_TITLE } from '../consts';
import { getPosts } from '../utils/posts';

const posts = await getPosts();
const latest = posts.slice(0, 5);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>{SITE_TITLE}</h1>
				<p class="subtitle">{SITE_SHORT}</p>
				<p class="intro">{SITE_INTRO}</p>
			</section>

			<section class="latest">
				<div class="section-head">
					<h2>最新文章</h2>
					<a href="/blog" class="more">全部文章 &rarr;</a>
				</div>
				<div class="list">
					{latest.map((post, i) => <PostCard post={post} featured={i === 0} />)}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		margin-bottom: 2em;
	}
	.hero h1 {
		margin-bottom: 0.25em;
	}
	.subtitle {
		margin: 0 0 0.75em 0;
		color: var(--accent);
		letter-spacing: 0.08em;
		font-size: 0.95em;
	}
	.intro {
		color: rgb(var(--gray));
		font-size: 1.1em;
		margin: 0;
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1em;
	}
	.section-head h2 {
		margin: 0;
		font-size: 1.35em;
	}
	.more {
		font-size: 0.85em;
		text-decoration: none;
	}
	.list {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5em 2em;
	}
	.list :global(.post-card.featured) {
		grid-column: 1 / -1;
	}
	@media (max-width: 720px) {
		.list {
			grid-template-columns: 1fr;
		}
	}
</style>
