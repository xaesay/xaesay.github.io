---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`404 · ${SITE_TITLE}`} description="页面不存在" />
	</head>
	<body>
		<Header />
		<main class="notfound">
			<h1>404</h1>
			<p>你要找的页面不在这里，可能已被移动或删除。</p>
			<p><a href="/">&larr; 回到首页</a></p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.notfound {
		text-align: center;
		padding: 6em 1em;
	}
	h1 {
		font-size: 4em;
		margin-bottom: 0.25em;
	}
</style>
