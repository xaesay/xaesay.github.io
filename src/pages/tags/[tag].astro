---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_TITLE } from '../../consts';
import { getPosts } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	const seen = new Set<string>();
	for (const post of posts) {
		for (const tag of post.data.tags ?? []) seen.add(tag);
	}
	return [...seen].map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = (await getPosts()).filter((post) => post.data.tags?.includes(tag));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`标签「${tag}」· ${SITE_TITLE}`} description={`${SITE_TITLE} 中标签为 ${tag} 的文章`} />
	</head>
	<body>
		<Header />
		<main>
			<p class="crumb"><a href="/tags">&larr; 全部标签</a></p>
			<h1>#{tag}</h1>
			<p class="count">共 {posts.length} 篇</p>
			<div class="list">
				{posts.map((post, i) => <PostCard post={post} featured={i === 0} />)}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.crumb {
		font-size: 0.85em;
	}
	.crumb a {
		text-decoration: none;
	}
	h1 {
		margin-bottom: 0;
	}
	.count {
		color: rgb(var(--gray));
		font-size: 0.85em;
		margin: 0 0 2em 0;
	}
	.list {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5em 2em;
	}
	.list :global(.post-card.featured) {
		grid-column: 1 / -1;
	}
	@media (max-width: 720px) {
		.list {
			grid-template-columns: 1fr;
		}
	}
</style>
